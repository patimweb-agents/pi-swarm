{
  "name": "@patimweb/pi-swarm",
  "version": "2.0.1",
  "description": "pi swarm: a peer-to-peer network of pi agents. Announce, connect with consent, exchange messages and share a session knowledge board -- across machines, no central server.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "swarm",
    "p2p",
    "peer-to-peer",
    "multi-agent",
    "orchestration",
    "lan"
  ],
  "author": "Patrick Weppelmann",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patimweb-agents/pi-swarm.git"
  },
  "bugs": {
    "url": "https://github.com/patimweb-agents/pi-swarm/issues"
  },
  "scripts": {
    "build": "echo 'No build step defined'",
    "test": "node --experimental-test-coverage --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:coverage": "node --experimental-test-coverage --test \"tests/**/*.test.ts\""
  },
  "files": [
    "index.ts",
    "src",
    "skills"
  ],
  "peerDependencies": {
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.0.0",
    "semantic-release": "^25.0.9",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
